{
  "name": "suthrayaa-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed-from-legacy-data.ts",
    "seed:rbac": "tsx scripts/seed-rbac.ts",
    "migrate:admin-roles": "tsx scripts/migrate-admin-roles.ts",
    "seed:categories": "tsx scripts/seed-categories.ts",
    "seed:catalog": "tsx scripts/reseed-real-catalog.ts",
    "setup:storage": "tsx scripts/setup-storage.ts",
    "list:users": "tsx scripts/list-users.ts",
    "promote:admin": "tsx scripts/promote-admin.ts",
    "sync:emails": "tsx scripts/sync-email-templates.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jose": "^5.9.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.9",
    "pdfkit": "^0.20.1",
    "pino": "^9.4.0",
    "pino-http": "^10.3.0",
    "razorpay": "^2.9.4",
    "sharp": "^0.33.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^7.0.4",
    "@types/pdfkit": "^0.17.6",
    "@types/ws": "^8.5.12",
    "pino-pretty": "^11.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.4"
  }
}

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google OAuth (configured in Supabase Dashboard -> Auth -> Providers -> Google;
# these are kept here only for reference / Google Cloud Console setup)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Supabase Auth "Send SMS" hook secret (Dashboard -> Auth -> Hooks)
SUPABASE_AUTH_HOOK_SECRET=

# Phone OTP provider — NOT YET CONFIGURED (placeholder only, see src/modules/webhooks/msg91-send-sms.hook.ts)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=

# Transactional email via Gmail SMTP (order confirmation to customer, notification to admin)
# GMAIL_APP_PASSWORD is a 16-char App Password from myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the Gmail account) — not the account login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=suthrayaa@gmail.com
